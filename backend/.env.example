PROJECT_NAME="AEGIS — Digital Risk Protection Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./aegis.db"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# Scoring weights (Social)
WEIGHT_SOCIAL_NAME=25.0
WEIGHT_SOCIAL_HANDLE=25.0
WEIGHT_SOCIAL_LOGO=20.0
WEIGHT_SOCIAL_BIO=15.0
WEIGHT_SOCIAL_SUSPICIOUS_TERMS=10.0
WEIGHT_SOCIAL_METADATA=5.0

# Scoring weights (Apps)
WEIGHT_APP_NAME=25.0
WEIGHT_APP_LOGO=20.0
WEIGHT_APP_DESCRIPTION=15.0
WEIGHT_APP_PUBLISHER_MISMATCH=15.0
WEIGHT_APP_PACKAGE_SIGNALS=10.0
WEIGHT_APP_CORROBORATING=15.0

# Apinex DeepSeek Evidence Explanation Integration
APINEX_API_KEY=your_apinex_api_key_here
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=free/deepseek-v4.1-flash
APINEX_TIMEOUT_SECONDS=60

# --- Live Social Media Monitoring Credentials (Optional) ---
# GitHub public search works out-of-the-box; personal access token increases rate limits
GITHUB_TOKEN=your_github_token_here
# Reddit Developer Application (script or web app) credentials
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
# Google Cloud YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here
# X / Twitter Developer Portal Bearer Token
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
# Meta Graph API User or Page Access Token
META_ACCESS_TOKEN=your_meta_access_token_here

# --- Live App Store Monitoring Credentials (Optional) ---
# Apple App Store iTunes Search API is public and requires no API key.
# Google Play Store optional Developer API key or third-party catalog API
GOOGLE_PLAY_API_KEY=your_google_play_api_key_here
